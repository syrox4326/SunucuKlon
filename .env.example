# Bu dosyayı kopyalayıp adını ".env" yap, sonra boşlukları doldur.
# Tırnak işareti KOYMA, "=" işaretinden sonra boşluk bırakma.

# Discord Developer Portal > Bot > Reset Token ile aldığın bot token'ı (kimseyle paylaşma!)
DISCORD_TOKEN=

# Discord Developer Portal > General Information > Application ID
CLIENT_ID=

# Senin Discord kullanıcı ID'n (botu sadece sen kullanabilirsin)
OWNER_ID=

# Komutların görüneceği sunucunun ID'si. Birden fazla sunucu için virgülle ayır: 111,222
GUILD_ID=
